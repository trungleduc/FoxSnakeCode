    {
      "title": "11. Decoy Vault",
      "instructions": "HQ: Intel confirms the red chips are decoys wired to the alarm. Every chip has a `trapped` value, so use `if not c.trapped:` to leave them alone.",
      "starterCode": "for c in chips:\n    turn_to(c)\n    step(distance_to(c))\n",
      "scene": {
        "start": {
          "x": 100,
          "y": 250,
          "angle": 0
        },
        "chips": [
          {
            "x": 250,
            "y": 100
