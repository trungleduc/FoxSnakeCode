            "y": 300
          },
          {
            "x": 300,
            "y": 300
          }
        ],
        "obstacles": [
          {
            "x": 350,
            "y": 150,
            "w": 100,
            "h": 100
          }
        ]
      }
    },
    {
      "title": "10. Cargo Bay",
      "instructions": "HQ: Crates block the way through the cargo bay. Put your detour in a function: turn left, walk 100, turn right, walk 200, turn right, walk 100, turn left. Then use a loop to repeat it. Keep clear of the laser.",
      "starterCode": "def around_crate():\n    turn(-90)\n    step(100)\n    # finish the detour\n\nstep(100)\n",
      "scene": {
        "start": {
          "x": 50,
          "y": 300,
          "angle": 0
