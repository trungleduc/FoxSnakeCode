{
  "title": "Python Quest 1: Sequencing",
  "levels": [
    {
      "title": "1.1 Hello, Fox",
      "instructions": "HQ: Grep Fox, this is Sudo Snake. Your first order: type `step(100)` and press Run. One floor panel is 100 steps wide.",
      "starterCode": "",
      "scene": {
        "start": { "x": 300, "y": 250, "angle": 0 },
        "chips": [{ "x": 400, "y": 250 }]
      }
    },
    {
      "title": "1.2 Long Hall",
      "instructions": "HQ: Same order, longer hall. The number inside `step()` says how far to go. Count the floor panels and change it.",
      "starterCode": "step(100)\n",
      "scene": {
        "start": { "x": 150, "y": 250, "angle": 0 },
        "chips": [{ "x": 550, "y": 250 }],
        "obstacles": [
          { "x": 100, "y": 100, "w": 550, "h": 100 },
          { "x": 100, "y": 300, "w": 550, "h": 100 }
        ]
      }
    },
    {
      "title": "1.3 Corner",
      "instructions": "HQ: The hall bends. `turn(90)` turns right and `turn(-90)` turns left. Walk to the corner, turn, and keep going.",
      "starterCode": "step(300)\n",
      "scene": {
        "start": { "x": 150, "y": 350, "angle": 0 },
        "chips": [{ "x": 450, "y": 150 }],
        "obstacles": [{ "x": 100, "y": 100, "w": 300, "h": 200 }]
      }
    },
    {
      "title": "1.4 Two Chips",
      "instructions": "HQ: Two chips on a Z-shaped path. Your orders run from top to bottom, so put them in the order you want them done.",
      "starterCode": "step(300)\nturn(90)\n",
      "scene": {
        "start": { "x": 150, "y": 150, "angle": 0 },
        "chips": [
          { "x": 450, "y": 150 },
          { "x": 650, "y": 350 }
        ],
        "obstacles": [
          { "x": 100, "y": 200, "w": 300, "h": 200 },
          { "x": 500, "y": 100, "w": 200, "h": 200 }
        ]
      }
    },
    {
      "title": "1.5 Detour",
      "instructions": "HQ: A wall of crates blocks the straight route. Plan a way around it before you run. Going over the top or under the bottom both work.",
      "starterCode": "step(100)\nturn(-90)\n",
      "scene": {
        "start": { "x": 150, "y": 250, "angle": 0 },
        "chips": [{ "x": 550, "y": 250 }],
        "obstacles": [{ "x": 350, "y": 100, "w": 100, "h": 300 }]
      }
    },
    {
      "title": "1.6 Backtrack",
      "instructions": "HQ: The first chip is up a dead end. Grab it, then use `turn(180)` to face back the way you came and go on to the second chip.",
      "starterCode": "step(200)\nturn(-90)\nstep(200)\n",
      "scene": {
        "start": { "x": 150, "y": 350, "angle": 0 },
        "chips": [
          { "x": 350, "y": 150 },
          { "x": 650, "y": 350 }
        ],
        "obstacles": [
          { "x": 100, "y": 100, "w": 200, "h": 200 },
          { "x": 400, "y": 100, "w": 300, "h": 200 },
          { "x": 300, "y": 50, "w": 100, "h": 50 }
        ]
      }
    },
    {
      "title": "1.7 First Bug",
      "instructions": "HQ: A Sentry Bug is crossing your path. The yellow cone is what it can see, and touching it counts too. Use `wait(seconds)` to let it walk past, then go.",
      "starterCode": "step(500)\n",
      "scene": {
        "start": { "x": 150, "y": 250, "angle": 0 },
        "chips": [{ "x": 650, "y": 250 }],
        "guards": [
          { "route": [{ "x": 450, "y": 60 }, { "x": 450, "y": 440 }], "speed": 80 }
        ]
      }
    },
    {
      "title": "1.8 Boss: Server Room",
      "instructions": "HQ: Three chips and one Sentry Bug. Follow the halls to the first two chips, stop one panel before the bug's path, and wait for your moment to cross. Then finish the job.",
      "starterCode": "step(200)\nturn(-90)\n",
      "scene": {
        "start": { "x": 150, "y": 350, "angle": 0 },
        "chips": [
          { "x": 350, "y": 350 },
          { "x": 350, "y": 150 },
          { "x": 750, "y": 350 }
        ],
        "obstacles": [
          { "x": 100, "y": 100, "w": 200, "h": 200 },
          { "x": 400, "y": 200, "w": 200, "h": 200 }
        ],
        "guards": [
          { "route": [{ "x": 650, "y": 440 }, { "x": 650, "y": 60 }], "speed": 60 }
        ]
      }
    }
  ]
}
