    },
    {
      "title": "12. Final Run",
      "instructions": "Use everything you've learned. Write a `grab` function, loop over `chips`, and skip the traps. Watch out for the searchlight and the lasers.",
      "starterCode": "def grab(chip):\n    # face the chip and walk to it\n    pass\n\nfor c in chips:\n    # grab the chip unless it is trapped\n    pass\n",
