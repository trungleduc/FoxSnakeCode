    {
      "title": "11. Trapped Chips",
      "instructions": "The red chips are traps! Every chip has a `trapped` value, so use `if not c.trapped:` to skip them.",
      "starterCode": "for c in chips:\n    turn_to(c)\n    step(distance_to(c))\n",
      "scene": {
        "start": {
          "x": 100,
          "y": 250,
          "angle": 0
        },
        "chips": [
