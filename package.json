{
  "name": "foxsnakecode",
  "version": "0.1.0",
  "description": "A coding puzzle game for JupyterLab and JupyterLite",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension"
  ],
  "author": {
    "name": "Trung Le",
    "email": "trung.le@quantstack.net"
  },
  "files": [
    "lib/**/*.{d.ts,js,js.map}",
    "style/**/*.{css,js}",
    "src/**/*.ts"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "styleModule": "style/index.js",
  "sideEffects": [
    "style/*.css",
    "style/index.js"
  ],
  "scripts": {
    "build": "jlpm build:lib && jlpm build:labextension:dev",
    "build:prod": "jlpm clean && jlpm build:lib && jlpm build:labextension",
    "build:labextension": "jupyter-builder build .",
    "build:labextension:dev": "jupyter-builder build --development True .",
    "build:demo": "node script/build-demo.mjs",
    "update:demo": "node script/update-demo.mjs",
    "build:lib": "tsc --sourceMap",
    "clean": "rimraf lib tsconfig.tsbuildinfo foxsnakecode/labextension foxsnakecode/_version.py",
    "watch": "run-p watch:src watch:labextension",
    "watch:src": "tsc -w --sourceMap",
    "watch:labextension": "jupyter-builder watch ."
  },
  "dependencies": {
    "@jupyter-ai/jupyternaut-lite": "~0.21.0",
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/apputils": "^4.0.0",
    "@jupyterlab/codeeditor": "^4.0.0",
    "@jupyterlab/docregistry": "^4.0.0",
    "@jupyterlab/launcher": "^4.0.0",
    "@jupyterlab/services": "^7.0.0",
    "@jupyterlab/ui-components": "^4.0.0",
    "@lumino/widgets": "^2.0.0"
  },
  "devDependencies": {
    "@jupyter/builder": "^1.0.0",
    "npm-run-all2": "^7.0.1",
    "rimraf": "^5.0.1",
    "tar": "^7.5.2",
    "typescript": "~5.5.4"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "foxsnakecode/labextension",
    "sharedPackages": {
      "@jupyter-ai/jupyternaut-lite": {
        "bundled": false,
        "singleton": true
      }
    }
  }
}
